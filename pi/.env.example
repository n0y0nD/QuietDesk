# Copy this file to .env and paste your Meta Model API key after the = sign.
MODEL_API_KEY=
QUIETDESK_MODEL=muse-spark-1.3
# Where QuietDesk speaks: browser (laptop speakers) or pi (a speaker paired to the Pi)
QUIETDESK_SPEAK_ON=browser

# Real phone through KDE Connect: which apps reach QuietDesk ("all" for every app), or QUIETDESK_PHONE=off
# QUIETDESK_PHONE_APPS=WhatsApp,WhatsApp Business,Messages,Telegram,Signal,Slack,Discord,Gmail,Instagram

# City for the weather on the desk screen (Open-Meteo, free, no key)
# QUIETDESK_CITY=Bengaluru

# Auto-replies in every focus session without asking ("busy until 5:30 PM"; one per person, never to
# urgent messages, marked as an auto-reply). Say "don't auto-reply" to turn them off for one session.
# QUIETDESK_FOCUS_AUTO_REPLY=on
